# ---- LLM (pluggable). Default "mock" runs fully offline with no model.
# LLM_PROVIDER=openai talks to ANY OpenAI-compatible endpoint.
LLM_PROVIDER=mock
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_API_KEY=

# Examples (set LLM_PROVIDER=openai):
#  Ollama (container in this compose, profile "ollama"): http://ollama:11434/v1  model qwen2.5:1.5b-instruct
#  LiteLLM proxy (profile "litellm"; fronts Anthropic/Gemini/Bedrock/...): http://litellm:4000/v1  model small
#  OpenAI:      https://api.openai.com/v1      model <a mini/nano model>  key sk-...
#  OpenRouter:  https://openrouter.ai/api/v1   model <any small model>    key ...
#  Groq/Together/vLLM/llama.cpp server: their OpenAI-compatible base URL

# ---- Embeddings: hash (offline, no model) | openai (any /v1/embeddings) | none
EMBED_PROVIDER=hash
EMBED_DIM=256
# For real embeddings via Ollama:  EMBED_PROVIDER=openai EMBED_MODEL=nomic-embed-text EMBED_DIM=768
# (changing EMBED_DIM needs: docker compose down -v, since the vector column is created with that size)

# ---- Limits
MAX_PARTICIPANTS=8
SESSION_TTL_DAYS=14
MAX_SESSION_TOKENS=200000
WEATHER=1
POSTGRES_PASSWORD=netrip
