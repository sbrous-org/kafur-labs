# ========== LLM Configuration ==========
# Provider: 'mock' (offline stub, default) | 'claude' | 'openai' | 'openrouter'
LLM_PROVIDER=mock

# Mock - Deterministic offline stub. No GPU, no key, no network. Runs the bot end to
# end (routing, KB, weather guardrails) for dev/eval. Answer text is canned, not real.
# Switch to a hosted provider below for real answers.

# Claude (Anthropic) - Cheapest hosted option
# Get API key: https://console.anthropic.com/
# Claude 3.5 Haiku: $0.80/1M input, $4/1M output tokens
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenRouter - Supports GPT-4o, Claude, Gemini via single API
# Get free API key: https://openrouter.ai/
# Pay per use (GPT-4o: ~$0.005/1K tokens)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI - Direct API
# Get free trial ($5): https://platform.openai.com/account/api-keys
# GPT-3.5-turbo: $0.50/1M input, $1.50/1M output tokens
OPENAI_API_KEY=sk-your-key-here

# Optional: Override default model per provider
# LLM_MODEL=claude-3-5-haiku-20241022   # Claude default
# LLM_MODEL=openai/gpt-4o               # OpenRouter with GPT-4o
# LLM_MODEL=gpt-3.5-turbo               # OpenAI default

# ========== Weather API (Optional) ==========
# Bot works with mock data if not provided
OPENWEATHER_API_KEY=your-openweather-key-here

# ========== Application ==========
ENV=development

# ========== Frontend ==========
REACT_APP_API_URL=http://localhost:8000
